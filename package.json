{
  "name": "patch-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "prove-codex": "node --import tsx scripts/prove-codex.ts",
    "start": "node --import tsx apps/server/index.ts",
    "format": "prettier --write apps packages scripts tests playwright.config.ts tsconfig.json package.json",
    "test:e2e:live": "PATCH_PARTY_LIVE_CODEX=1 playwright test --grep \"rule artifact\"",
    "prove-codex:saved": "node --import tsx scripts/prove-codex.ts --saved",
    "setup:https": "node --import tsx scripts/setup-https.ts",
    "test:e2e:https": "PATCH_PARTY_TEST_ORIGIN=https://127.0.0.1:5173 playwright test tests/browser/milestone3.spec.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.166.0",
    "acorn": "^8.19.0",
    "phaser": "^3.90.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
