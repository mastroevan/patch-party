# Register a Confidential Twitch app. Exact OAuth redirect URL:
# https://127.0.0.1:5173/api/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: restrict sign-in to this broadcaster's Twitch login (no @).
TWITCH_BROADCASTER_LOGIN=

PATCH_PARTY_ORIGIN=https://127.0.0.1:5173
# Leave blank for a new random operator key on every server start.
# If set, use at least 24 random characters. This is separate from Twitch auth.
PATCH_PARTY_OPERATOR_KEY=
